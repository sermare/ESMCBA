    "import numpy as np\n",
    "import pandas as pd\n",
    "import logomaker\n",
    "\n",
    "amino_acids = list(\"ACDEFGHIKLMNPQRSTVWY\")\n",
    "\n",
    "for n in range(8, 12):\n",
    "    seqs = results[(results['length'] == n)]['epitope'].tolist()\n",
    "    L = len(seqs)\n",
    "    if L == 0:\n",
    "        continue\n",
    "\n",
    "    # 1) build raw counts\n",
    "    counts = np.zeros((n, len(amino_acids)), dtype=float)\n",
    "    for seq in seqs:\n",
    "        for i, aa in enumerate(seq):\n",
    "            counts[i, amino_acids.index(aa)] += 1\n",
    "\n",
    "    # 2) add a tiny pseudocount to avoid zeros\n",
    "    pseudocount = 1e-6\n",
    "    counts += pseudocount\n",
    "    # adjust denominator so freq still sums to 1 \n",
    "    freq = counts / (L + pseudocount * len(amino_acids))\n",
    "\n",
    "    # 3) background = mean over positions\n",
    "    background_freq = freq.mean(axis=0)\n",
    "\n",
    "    # 4) enrichment and log2‐ratio\n",
    "    enrichment = freq / background_freq[np.newaxis, :]\n",
    "    log2_enrich = np.log2(enrichment)\n",
    "\n",
    "    # 5) optionally clamp or nan‐replace (if you STILL get nan/inf)\n",
    "    # log2_enrich = np.nan_to_num(log2_enrich, nan=0.0, posinf=np.max(log2_enrich[np.isfinite(log2_enrich)]), neginf=np.min(log2_enrich[np.isfinite(log2_enrich)]))\n",
    "\n",
    "    enrich_df = pd.DataFrame(log2_enrich, columns=amino_acids)\n",
    "\n",
    "    # 6) plot – note allow_nan=True if you choose the nan‐replace route\n",
    "    logo = logomaker.Logo(\n",
    "        enrich_df,\n",
    "        # shade_below_zero=True,\n",
    "        # fade_below_zero=True,\n",
    "        color_scheme='chemistry',\n",
    "        # allow_nan=True\n",
    "    )\n",
    "    logo.ax.set_title(f\"{n}-mer site-wise log₂‐enrichment\")\n",
    "    logo.ax.set_ylabel(\"log₂ Enrichment\")\n",
    "    logo.ax.set_xlabel(\"Peptide position\")\n"
   ]
  },
