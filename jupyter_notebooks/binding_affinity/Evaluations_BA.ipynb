    "evaluations_dt_subset = evaluations_dt[(evaluations_dt['time'].astype('str').str.contains('2025-04'))]\n",
    "evaluations_dt_subset['rank_mse'] = evaluations_dt_subset.groupby('HLA')['mse'].rank(ascending=True)\n",
    "evaluations_dt_subset['rank_corr'] = evaluations_dt_subset.groupby('HLA')['spearman'].rank(ascending=False)\n",
    "\n",
    "# 2. Sum the ranks or any other combination you want.\n",
    "evaluations_dt_subset['rank_sum'] = evaluations_dt_subset['rank_mse'] + evaluations_dt_subset['rank_corr']\n",
    "\n",
    "evaluations_dt_subset['HLA'] = evaluations_dt_subset['HLA'].str.replace('HLA', '')\n",
    "\n",
    "# 3. Sort by rank_sum and pick the best model for each HLA.\n",
    "ranked_per_HLA = (\n",
    "    evaluations_dt_subset\n",
    "    .sort_values('rank_sum', ascending=True)\n",
    "    .drop_duplicates(subset='HLA', keep='first')  \n",
    ")\n",
    "\n",
    "ranked_per_HLA = ranked_per_HLA[ranked_per_HLA['HLA'].apply(len) == 5] "
