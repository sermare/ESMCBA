    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Pivot median Spearman, rename to avoid column name collision, reset index\n",
    "spearman_pivot = medians.pivot(\n",
    "    index=['HLA', 'data_prop', 'trained_blocks', 'lr_transformer', 'lr_regression'],\n",
    "    columns='encoding',\n",
    "    values='spearman'\n",
    ").dropna()\n",
    "\n",
    "# Rename pivoted columns so 'HLA' index resets without conflict\n",
    "spearman_pivot = spearman_pivot.rename(columns={\n",
    "    'epitope': 'spearman_epitope',\n",
    "    'HLA': 'spearman_HLA'\n",
    "}).reset_index()\n",
    "\n",
    "# 2. Plot Spearman with seaborn, hue by learning rate or HLA\n",
    "plt.figure()\n",
    "sns.scatterplot(\n",
    "    data=spearman_pivot,\n",
    "    x='spearman_epitope',\n",
    "    y='spearman_HLA',\n",
    "    hue='trained_blocks',  # or hue='HLA' to color by allele\n",
    "    alpha=0.8\n",
    ")\n",
    "lims = [\n",
    "    min(spearman_pivot.spearman_epitope.min(), spearman_pivot.spearman_HLA.min()),\n",
    "    max(spearman_pivot.spearman_epitope.max(), spearman_pivot.spearman_HLA.max())\n",
    "]\n",
    "plt.plot(lims, lims, linestyle='--')\n",
    "plt.xlabel('Epitope Median Spearman')\n",
    "plt.ylabel('HLA Median Spearman')\n",
    "plt.title('Spearman: Epitope vs HLA (matched hyperparameters)')\n",
    "plt.tight_layout()\n",
    "\n",
    "# 3. Pivot median Pearson, rename, reset index\n",
    "pearson_pivot = medians.pivot(\n",
    "    index=['HLA', 'data_prop', 'trained_blocks', 'lr_transformer', 'lr_regression'],\n",
    "    columns='encoding',\n",
    "    values='pearsonr'\n",
    ").dropna()\n",
    "\n",
    "pearson_pivot = pearson_pivot.rename(columns={\n",
    "    'epitope': 'pearson_epitope',\n",
    "    'HLA': 'pearson_HLA'\n",
    "}).reset_index()\n",
    "\n",
    "# 4. Plot Pearson with seaborn, hue by learning rate or HLA\n",
    "plt.figure()\n",
    "sns.scatterplot(\n",
    "    data=pearson_pivot,\n",
    "    x='pearson_epitope',\n",
    "    y='pearson_HLA',\n",
    "    hue='trained_blocks',  # or hue='HLA'\n",
    "    alpha=0.8\n",
    ")\n",
    "lims = [\n",
    "    min(pearson_pivot.pearson_epitope.min(), pearson_pivot.pearson_HLA.min()),\n",
    "    max(pearson_pivot.pearson_epitope.max(), pearson_pivot.pearson_HLA.max())\n",
    "]\n",
    "plt.plot(lims, lims, linestyle='--')\n",
    "plt.xlabel('Epitope Median Pearson')\n",
    "plt.ylabel('HLA Median Pearson')\n",
    "plt.title('Pearson: Epitope vs HLA (matched hyperparameters)')\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.show()\n"
   ]
