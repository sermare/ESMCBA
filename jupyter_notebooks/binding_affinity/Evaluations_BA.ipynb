    "# Get the unique alleles from evaluations_dt_sorted\n",
    "alleles = evaluations_dt_sorted[(evaluations_dt_sorted['spearman'].notna()) & (evaluations_dt_sorted['n_evaluations'] > 2)]['HLA'].unique()\n",
